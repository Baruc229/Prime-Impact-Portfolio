{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/creation-site", "destination": "/service-creation-site" },
    { "source": "/tunnels-vente", "destination": "/service-tunnels-vente" },
    { "source": "/referencement-seo", "destination": "/service-referencement-seo" },
    { "source": "/refonte-site", "destination": "/service-refonte-site" },
    { "source": "/suivi-accompagnement", "destination": "/service-suivi-accompagnement" }
  ]
}