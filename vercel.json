{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/creation-site", "destination": "/service-creation-site" },
    { "source": "/tunnels-vente", "destination": "/service-tunnels-vente" },
    { "source": "/referencement-seo", "destination": "/service-referencement-seo" },
    { "source": "/refonte-site", "destination": "/service-refonte-site" },
    { "source": "/suivi-accompagnement", "destination": "/service-suivi-accompagnement" },
    { "source": "/blog", "destination": "/blog/index" },
    { "source": "/blog/:slug", "destination": "/blog/post" }
  ]
}